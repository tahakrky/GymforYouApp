{
  "name": "gymforyou-desktop",
  "version": "1.0.0",
  "description": "GymForYou — antrenman takibi",
  "author": "GymForYou",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-app": "node scripts/copy-dist.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.gymforyou.app",
    "productName": "GymForYou",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["main.js", "app/**/*"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GymForYou"
    }
  }
}
